<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- VSTest JUnit XML logger: enables the 'junit' test logger for GitLab test reports. -->
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lidarr.Plugin.YtDlp\Lidarr.Plugin.YtDlp.csproj" />
  </ItemGroup>

  <!--
    Direct host references: the plugin project uses DisableTransitiveProjectReferences
    (so host DLLs never leak into the plugin output), which also blocks the transitive
    flow here. The test host needs the assemblies at RUNTIME (type-load smoke tests
    instantiate the plugin providers against them), so reference them directly and let
    them copy into the test output.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ext\Lidarr\src\NzbDrone.Common\Lidarr.Common.csproj" />
    <ProjectReference Include="..\ext\Lidarr\src\NzbDrone.Core\Lidarr.Core.csproj" />
    <ProjectReference Include="..\ext\Lidarr\src\Lidarr.Http\Lidarr.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
