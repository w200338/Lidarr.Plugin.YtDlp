<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lidarr.Plugin.YtDlp</RootNamespace>
    <AssemblyName>Lidarr.Plugin.YtDlp</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Copy resolved NuGet reference assemblies into the output folder so the
      Release-only ILRepack step can merge them in. The shippable artifact is
      built by the ZipRelease target from an explicit file list, so these
      sidecars never end up in the plugin zip.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions must stay >= what the Lidarr.Plugin.Common/Abstractions submodule
         references (CliWrap 3.10.1, M.E.Logging.Abstractions 8.0.3) to avoid NU1605. -->
    <PackageReference Include="CliWrap" Version="3.10.1" />
    <PackageReference Include="FluentValidation" Version="9.5.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <!-- ILRepack MSBuild task (build-time only, never shipped). -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Only Abstractions is referenced: the host's PluginLoadContext
      (ext/.../Abstractions/Hosting/PluginLoadContext.cs) SHARED-ASSEMBLIES
      "Lidarr.Plugin.Abstractions" (and M.E.DI/Logging.Abstractions) with the host,
      so the plugin must keep its reference to it un-merged for type identity.
      Lidarr.Plugin.Common is deliberately NOT referenced: it is unused by this
      plugin and would drag a 1.3 MB closure (DataProtection, TagLibSharp, M.E.*)
      that cannot be merged (host-shared type identity) nor shipped (forbidden).
    -->
    <ProjectReference Include="..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\plugin.json" Link="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests reach internal seams (settings external-test hook, parser helpers). -->
    <InternalsVisibleTo Include="Lidarr.Plugin.YtDlp.Tests" />
  </ItemGroup>

  <!--
    Release packaging:
      1. MergePluginDependencies — ILRepack merges CliWrap + FluentValidation into
         Lidarr.Plugin.YtDlp.dll (internalized/renamed so they cannot collide with
         host-provided copies across the collectible ALC). Everything else the DLL
         references is either .NET 8 framework (default ALC) or host-shared
         (Lidarr.Plugin.Abstractions, M.E.Logging.Abstractions).
      2. ZipRelease — stages exactly {Lidarr.Plugin.YtDlp.dll, plugin.json} into
         artifacts/net8.0.zip at the zip root, per the host install convention.
  -->
  <!-- The merge itself lives in ILRepack.targets (whose presence also suppresses
       the ILRepack package's built-in merge-everything fallback target). -->
  <PropertyGroup>
    <ZipToolsDir>$(MSBuildProjectDirectory)/../tools/zip-packager</ZipToolsDir>
    <ZipArtifactDir>$(MSBuildProjectDirectory)/../artifacts</ZipArtifactDir>
  </PropertyGroup>

  <Target Name="ZipRelease" AfterTargets="MergePluginDependencies" Condition="'$(Configuration)' == 'Release' and '$(SkipMerge)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <MakeDir Directories="$(ZipArtifactDir)" />
    <Exec Command="dotnet build &quot;$(ZipToolsDir)/zip-packager.csproj&quot; -c Release -v q --nologo" />
    <Exec Command="dotnet &quot;$(ZipToolsDir)/bin/Release/net8.0/zip-packager.dll&quot; &quot;$(ZipArtifactDir)/net8.0.zip&quot; &quot;$(TargetDir)Lidarr.Plugin.YtDlp.dll&quot; &quot;$(TargetDir)plugin.json&quot;" />
    <Message Importance="high" Text="Created plugin artifact: $(ZipArtifactDir)/net8.0.zip" />
  </Target>

</Project>
