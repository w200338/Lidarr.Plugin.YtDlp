<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lidarr.Plugin.YtDlp</RootNamespace>
    <AssemblyName>Lidarr.Plugin.YtDlp</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      The host projects reference each other (e.g. Lidarr.Core -> Lidarr.SignalR).
      Without this, MSBuild synthesizes transitive project references and copies
      those assemblies (and their content) into the plugin output. We only compile
      against the three direct references above; nothing in the plugin references
      the host's other projects, so transitive project edges are pure noise.
    -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!--
      InformationalVersion is read by the host's Plugin.InstalledVersion
      (NzbDrone.Core.Plugins.Plugin) for the System -> Plugins UI and the
      GitHub update check. Keep it a plain "major.minor[.patch]" so
      PluginVersion.Parse succeeds.
    -->
    <InformationalVersion>0.2.0</InformationalVersion>
    <!--
      Copy resolved NuGet reference assemblies into the output folder so the
      Release-only ILRepack step can merge CliWrap in. Host project references
      below are marked runtime-excluded, so they never appear as output files.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.1" />
    <!-- ILRepack MSBuild task (build-time only, never shipped). -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NATIVE host model: the plugin compiles against the exact Lidarr host
      source (submodule pinned to v3.1.6.5079). These references are
      COMPILE-TIME ONLY:
        * ExcludeAssets="runtime" + Private=false => the host assemblies are
          neither copied to the plugin output nor listed as runtime deps.
        * At load time the host's collectible PluginLoadContext returns null
          for anything it cannot resolve from the plugin folder, so these
          types are bound against the host's own assemblies (same ALC).
      Merging any of them would create duplicate type identities and break
      every host interface we implement (verified against Tubifarry v2.3.1,
      which ships with exactly these as external references).
      FluentValidation, NLog, Newtonsoft.Json come transitively from the host
      projects and must stay external for the same reason.
    -->
    <ProjectReference Include="..\ext\Lidarr\src\NzbDrone.Common\Lidarr.Common.csproj"
                      ExcludeAssets="runtime" Private="false" />
    <ProjectReference Include="..\ext\Lidarr\src\NzbDrone.Core\Lidarr.Core.csproj"
                      ExcludeAssets="runtime" Private="false" />
    <ProjectReference Include="..\ext\Lidarr\src\Lidarr.Http\Lidarr.Http.csproj"
                      ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests reach internal seams (runner factory, scheduler delays, parser helpers). -->
    <InternalsVisibleTo Include="Lidarr.Plugin.YtDlp.Tests" />
  </ItemGroup>

  <!--
    Release packaging:
      1. MergePluginDependencies (ILRepack.targets) merges CliWrap into
         Lidarr.Plugin.YtDlp.dll, internalized + renamed so it cannot collide
         with anything on the host. Host-contract dependencies (Lidarr.Core,
         Lidarr.Common, Lidarr.Http, NLog, FluentValidation, Newtonsoft.Json)
         stay EXTERNAL: the host resolves them, and its Test()/validation
         signatures expose host-visible FluentValidation/NLog types.
      2. ZipRelease stages exactly {Lidarr.Plugin.YtDlp.dll} at the zip root.
         The native host loads only "Lidarr.Plugin.*.dll" from
         {AppData}/plugins/{owner}/{name}/ and ignores plugin.json entirely.
  -->
  <PropertyGroup>
    <ZipToolsDir>$(MSBuildProjectDirectory)/../tools/zip-packager</ZipToolsDir>
    <ZipArtifactDir>$(MSBuildProjectDirectory)/../artifacts</ZipArtifactDir>
  </PropertyGroup>

  <!--
    Belt and braces: the host project references can still leak content (e.g.
    Localization) or NuGet-native assets (runtimes/, sqlite) into the output.
    Nothing in the final artifact except the plugin DLL and (pre-merge) CliWrap
    is ever loaded or merged, so remove everything else before packaging.
  -->
  <Target Name="CleanExtraneousOutput" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <ItemGroup>
      <_ExtraneousOutput Include="$(TargetDir)**" Exclude="$(TargetDir)Lidarr.Plugin.YtDlp.dll;$(TargetDir)Lidarr.Plugin.YtDlp.pdb;$(TargetDir)Lidarr.Plugin.YtDlp.deps.json;$(TargetDir)CliWrap.dll" />
    </ItemGroup>
    <Delete Files="@(_ExtraneousOutput)" />
  </Target>

  <Target Name="ZipRelease" AfterTargets="MergePluginDependencies" Condition="'$(Configuration)' == 'Release' and '$(SkipMerge)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <MakeDir Directories="$(ZipArtifactDir)" />
    <Exec Command="dotnet build &quot;$(ZipToolsDir)/zip-packager.csproj&quot; -c Release -v q --nologo" />
    <!--
      DOTNET_ROLL_FORWARD=Major lets the net8.0 tool also run on a host that
      only has a newer runtime (e.g. a developer box with .NET 10). On the CI
      image (sdk:8.0) it is a no-op.
    -->
    <Exec Command="dotnet &quot;$(ZipToolsDir)/bin/Release/net8.0/zip-packager.dll&quot; &quot;$(ZipArtifactDir)/net8.0.zip&quot; &quot;$(TargetDir)Lidarr.Plugin.YtDlp.dll&quot;" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <Message Importance="high" Text="Created plugin artifact: $(ZipArtifactDir)/net8.0.zip" />
  </Target>

</Project>
